# Salin file ini menjadi `.env` lalu isi sesuai lingkungan Anda. JANGAN commit file `.env`.

# --- Server ---
APP_PORT=3080
# "dev" = nilai sensor yang kosong diganti angka acak (untuk uji tanpa alat). Kosongkan/isi "prod" untuk data asli.
APP_MODE=prod
# 1 = aktifkan streaming webcam lewat Socket.IO (butuh node-webcam dan kamera)
APP_WEBCAM=0

# --- CORS: alamat website yang boleh memanggil API ---
CLIENT_PORT=3081
CLIENT_HOST=http://localhost:3081
CLIENT_SOCKET_PORT=3081
CLIENT_SOCKET_HOST=http://localhost:3081

# --- Autentikasi ---
# Wajib diisi string acak yang panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# --- Database (MySQL/MariaDB) ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=tel_u

# --- MQTT ---
MQTT_BROKER_HOST=127.0.0.1
MQTT_PORT=1883
# Simpan ke database setiap N pesan MQTT (sesuaikan dengan interval publish alat)
MQTT_SUBSCRIBE_COUNT=10

# Topik perintah (API -> alat). Isi sesuai topik yang didengarkan firmware masing-masing alat.
VITE_MQTT_PLTB_COMMAND=
VITE_MQTT_PLTMH_COMMAND=
VITE_MQTT_PV_COMMAND=

# --- Batas tegangan untuk fitur Smart Voltage Control (volt) ---
VOLTAGE_MIN=5
VOLTAGE_MAX=24
