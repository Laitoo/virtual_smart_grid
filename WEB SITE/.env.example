# Salin file ini menjadi `.env` lalu sesuaikan. JANGAN commit file `.env`.

# Alamat API (backend) dan Socket.IO. Port API default 3080 (lihat APP_PORT di API/.env).
VITE_API_SERVER_HOST=http://localhost:3080
VITE_SOCKET_SERVER_HOST=http://localhost:3080

# Tujuan redirect: setelah sesi tidak valid / belum login
VITE_REDIRECT_TO_HOME=/
VITE_REDIRECT_TO_LOGIN=/login
